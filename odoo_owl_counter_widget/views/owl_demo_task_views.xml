<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="owl_demo_task_view_list" model="ir.ui.view">
        <field name="name">owl.demo.task.list</field>
        <field name="model">owl.demo.task</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="quantity"/>
                <!-- Les widgets de champ fonctionnent aussi en liste -->
                <field name="state" widget="status_badge"/>
            </tree>
        </field>
    </record>

    <record id="owl_demo_task_view_form" model="ir.ui.view">
        <field name="name">owl.demo.task.form</field>
        <field name="model">owl.demo.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Barre d'état cliquable pour changer la valeur et voir le badge évoluer -->
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <!-- widget="counter" ; l'option step est lue par extractProps -->
                        <field name="quantity" widget="counter" options="{'step': 1}"
                               readonly="state == 'done'"/>
                        <field name="state" widget="status_badge" string="Status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="owl_demo_task_action" model="ir.actions.act_window">
        <field name="name">OWL Widgets Demo</field>
        <field name="res_model">owl.demo.task</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="owl_demo_menu_root" name="OWL Widgets Demo" action="owl_demo_task_action"
              web_icon="odoo_owl_counter_widget,static/description/icon.png"/>
</odoo>
